#
# Dynamic bash completion for steelbx (installed by the RPM into
# /usr/share/bash-completion/completions).
#
# The binary generates its own completion registration at source time
# (clap_complete "dynamic" protocol), so this file is nothing but the
# one-liner installer you would put in your shell rc:
#
#   source <(COMPLETE=bash steelbx)
#
# There is nothing here that can drift out of sync: an upgrade ships the
# same file, and the installed binary always produces the matching
# script.
#
[ -n "${BASH_VERSION}" ] && command -v steelbx >/dev/null && \
  source <(COMPLETE=bash steelbx)
